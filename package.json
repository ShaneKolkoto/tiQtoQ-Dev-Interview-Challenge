{
  "name": "dev-interview-challenge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dev-interview-challenge/ui dev",
    "dev:api": "pnpm --filter @dev-interview-challenge/api dev",
    "build": "pnpm --filter @dev-interview-challenge/ui build && pnpm --filter @dev-interview-challenge/api build",
    "lint": "pnpm --filter @dev-interview-challenge/ui lint",
    "typecheck": "pnpm --filter @dev-interview-challenge/ui typecheck && pnpm --filter @dev-interview-challenge/api typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "5.9.2",
    "vitest": "^5.0.0"
  }
}
